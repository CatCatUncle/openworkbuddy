{
  "_desc": "暖调琥珀，适合生活/随笔/带货",
  "page": {
    "font-family": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "font-size": "16px",
    "line-height": "1.85",
    "color": "#2b2620",
    "letter-spacing": "0.4px",
    "word-break": "break-word",
    "padding": "0 2px"
  },
  "h1": {
    "font-size": "22px",
    "font-weight": "700",
    "color": "#2b2620",
    "line-height": "1.4",
    "margin": "0 0 10px",
    "text-align": "center"
  },
  "h2": {
    "font-size": "19px",
    "font-weight": "700",
    "color": "#c0803a",
    "line-height": "1.5",
    "margin": "34px 0 14px",
    "padding-left": "10px",
    "border-left": "4px solid #c0803a"
  },
  "h3": {
    "font-size": "17px",
    "font-weight": "700",
    "color": "#2b2620",
    "margin": "26px 0 12px"
  },
  "h4": {
    "font-size": "16px",
    "font-weight": "700",
    "color": "#7a6f60",
    "margin": "20px 0 10px"
  },
  "byline": {
    "font-size": "13px",
    "color": "#7a6f60",
    "text-align": "center",
    "margin": "0 0 26px"
  },
  "p": {
    "margin": "0 0 20px",
    "line-height": "1.85",
    "color": "#2b2620"
  },
  "strong": {
    "color": "#c0803a",
    "font-weight": "700"
  },
  "em": {
    "font-style": "normal",
    "color": "#7a6f60",
    "border-bottom": "1px dashed #ece0cd"
  },
  "link": {
    "color": "#c0803a",
    "text-decoration": "none",
    "border-bottom": "1px solid #fbf4e9"
  },
  "code_inline": {
    "font-family": "Menlo, Consolas, monospace",
    "font-size": "14px",
    "background": "#f6f7f9",
    "color": "#24292f",
    "padding": "2px 6px",
    "border-radius": "4px"
  },
  "pre_wrap": {
    "margin": "0 0 22px",
    "overflow-x": "auto",
    "border-radius": "8px",
    "background": "#f6f7f9"
  },
  "pre": {
    "margin": "0",
    "padding": "14px 16px",
    "font-family": "Menlo, Consolas, monospace",
    "font-size": "13px",
    "line-height": "1.7",
    "color": "#24292f",
    "white-space": "pre"
  },
  "quote": {
    "margin": "0 0 22px",
    "padding": "12px 16px",
    "background": "#fbf4e9",
    "border-left": "3px solid #c0803a",
    "color": "#7a6f60",
    "font-size": "15px",
    "line-height": "1.8"
  },
  "list": {
    "margin": "0 0 20px",
    "padding-left": "22px"
  },
  "li": {
    "margin": "0 0 8px",
    "line-height": "1.85",
    "color": "#2b2620"
  },
  "image": {
    "max-width": "100%",
    "height": "auto",
    "border-radius": "6px",
    "display": "block",
    "margin": "0 auto"
  },
  "figure": {
    "margin": "0 0 22px",
    "text-align": "center"
  },
  "caption": {
    "font-size": "13px",
    "color": "#7a6f60",
    "text-align": "center",
    "margin": "8px 0 0"
  },
  "hr": {
    "border": "none",
    "border-top": "1px solid #ece0cd",
    "margin": "30px 0"
  },
  "table": {
    "width": "100%",
    "border-collapse": "collapse",
    "font-size": "14px",
    "margin": "0 0 22px"
  },
  "th": {
    "border": "1px solid #ece0cd",
    "padding": "8px 10px",
    "background": "#fbf4e9",
    "color": "#2b2620",
    "font-weight": "700",
    "text-align": "left"
  },
  "td": {
    "border": "1px solid #ece0cd",
    "padding": "8px 10px",
    "color": "#2b2620"
  },
  "footer_note": ""
}