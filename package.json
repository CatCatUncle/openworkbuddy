{
  "name": "openworkbuddy",
  "version": "0.10.5",
  "description": "OpenWorkBuddy \u2014 AI Agent \u529e\u516c\u5de5\u4f5c\u53f0\uff08\u81ea\u7136\u8bed\u8a00\u4e0b\u4efb\u52a1\uff0cAI \u81ea\u4e3b\u89c4\u5212\u6267\u884c\uff0c\u4ea4\u4ed8 PPT/Word/Excel \u7b49\u6210\u679c\u6587\u4ef6\uff09",
  "type": "commonjs",
  "main": "electron-main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "app": "bash scripts/run-app.sh",
    "test": "node test/all.js",
    "stats": "node scripts/stats.js",
    "test:e2e": "node test/e2e.js",
    "lint": "node test/lint.js",
    "typecheck": "node test/typecheck.js",
    "cli": "node cli.js",
    "eval": "node eval/run.js",
    "demo:record": "electron scripts/record-demo.js",
    "icons": "bash scripts/make-icons.sh",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.js --mac --publish never",
    "dist:win": "electron-builder --config electron-builder.config.js --win --publish never",
    "pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.js --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@dagrejs/dagre": "^1.1.8",
    "@joint/core": "^4.3.3",
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@viz-js/viz": "^3.29.0",
    "docx": "^9.0.0",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "mermaid": "^11.17.0",
    "nodemailer": "^9.1.1",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3"
  },
  "bin": {
    "openworkbuddy": "./cli.js"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": {
    "name": "CatCatUncle",
    "email": "257534836+CatCatUncle@users.noreply.github.com"
  },
  "homepage": "https://github.com/CatCatUncle/openworkbuddy",
  "repository": {
    "type": "git",
    "url": "https://github.com/CatCatUncle/openworkbuddy.git"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.3"
    }
  }
}
