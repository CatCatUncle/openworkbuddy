{
  "name": "openworkbuddy",
  "version": "0.1.5",
  "description": "OpenWorkBuddy — AI Agent 办公工作台（自然语言下任务，AI 自主规划执行，交付 PPT/Word/Excel 等成果文件）",
  "type": "commonjs",
  "main": "electron-main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "test": "node test/e2e.js",
    "cli": "node cli.js",
    "eval": "node eval/run.js",
    "demo:record": "electron scripts/record-demo.js",
    "icons": "bash scripts/make-icons.sh",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.js --mac --publish never",
    "dist:win": "electron-builder --config electron-builder.config.js --win --publish never",
    "dist:linux": "electron-builder --config electron-builder.config.js --linux --publish never",
    "pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.js --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@viz-js/viz": "^3.29.0",
    "docx": "^9.0.0",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "mermaid": "^11.17.0",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "bin": {
    "wb": "./cli.js"
  },
  "author": {
    "name": "CatCatUncle",
    "email": "257534836+CatCatUncle@users.noreply.github.com"
  },
  "homepage": "https://github.com/CatCatUncle/openworkbuddy",
  "repository": {
    "type": "git",
    "url": "https://github.com/CatCatUncle/openworkbuddy.git"
  }
}
